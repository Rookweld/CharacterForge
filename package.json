{
  "name": "character-forge-quest-forge",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @character-forge/desktop dev",
    "build": "pnpm --filter @character-forge/desktop build",
    "preview": "pnpm --filter @character-forge/desktop preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @character-forge/desktop test",
    "test:watch": "pnpm --filter @character-forge/desktop test:watch",
    "lint": "biome lint apps/desktop package.json tsconfig.json biome.json",
    "check:version": "pwsh -NoProfile -File scripts/check-release-version.ps1",
    "release:verify": "pwsh -NoProfile -File scripts/release-verify.ps1",
    "format:check": "biome format apps/desktop package.json tsconfig.json biome.json",
    "format": "biome check --write apps/desktop package.json tsconfig.json biome.json",
    "tauri:dev": "pnpm --filter @character-forge/desktop tauri:dev",
    "tauri:build": "pnpm --filter @character-forge/desktop tauri:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
