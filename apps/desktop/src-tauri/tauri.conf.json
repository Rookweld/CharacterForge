{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Character Forge & Quest Forge",
  "version": "0.1.0",
  "identifier": "com.characterforge.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run dev",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "pnpm run build",
      "cwd": ".."
    },
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Character Forge / Quest Forge",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
